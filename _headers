# Interne mapper og arbeidskopier skal ikke indekseres av søkemotorer.
# (Cloudflare Pages leser denne filen; stien er fortsatt tilgjengelig,
# den holdes bare ute av Google.)
/design-test/*
  X-Robots-Tag: noindex
/demos/*
  X-Robots-Tag: noindex
/BS/*
  X-Robots-Tag: noindex
/verktoy/*
  X-Robots-Tag: noindex
/renrask/*
  X-Robots-Tag: noindex
/hanshaugerud/*
  X-Robots-Tag: noindex

# CSS og JS: alltid sjekk mot serveren (ETag → 304 når uendret).
# Uten dette lå stilarkene fire timer i nettleserens cache, og en ny
# index.html sto uten stil til cachen gikk ut. Én linje per fil, fordi
# det er det Pages garantert forstår.
